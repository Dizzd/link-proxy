# Keep the project name unchanged during upgrades to reuse the same volumes.
# Existing installations must use their original project name.
COMPOSE_PROJECT_NAME=link-proxy
# Defaults: PostgreSQL + proxy + Caddy. Add ,redis to enable the Redis service.
COMPOSE_PROFILES=postgres,caddy

# First startup only; restarting never overwrites stored credentials.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_PORT=9000
# Use :80 for HTTP/IP access; set a real DNS hostname for automatic HTTPS.
PUBLIC_HOST=:80
HTTP_PORT=80
HTTPS_PORT=443
# Direct Pingora access stays private; public access goes through Caddy.
PROXY_BIND_IP=127.0.0.1
PROXY_PORT=8080
RUST_LOG=info

POSTGRES_USER=proxy
POSTGRES_DB=proxy
# Generate a strong hex password: openssl rand -hex 32
POSTGRES_PASSWORD=
# Non-hex passwords must be URL-encoded in this URL.
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# Select config.redis.toml AND add redis to COMPOSE_PROFILES to enable Redis caching.
PROXY_CONFIG_FILE=config.toml
# SQLite: remove postgres from COMPOSE_PROFILES and set DATABASE_URL=sqlite:///data/proxy.db
# Existing external ingress: remove caddy from COMPOSE_PROFILES.
