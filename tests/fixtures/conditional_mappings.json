  ],
  "mappings": [
    {
      "id": "advanced-001",
      "mapping_key": "QRADV",
      "name": "Conditional campaign",
      "description": "",
      "enabled": true,
      "priority": 0,
      "source_matcher": {
        "hosts": [
          "abc.example.com"
        ],
        "path_type": "exact",
        "path_value": "/QRADV",
        "methods": [
          "GET"
        ]
      },
      "default_action": {
        "type": "redirect",
        "status": 302,
        "target_url": "https://default.example.com/",
        "path_handling": "replace",
        "query_policy": "drop"
      },
      "rules": [
        {
          "id": "weekday-mobile",
          "name": "Weekday mobile",
          "priority": 20,
          "enabled": true,
          "condition": {
            "type": "all",
            "conditions": [
              {
                "type": "device_type",
                "in": [
                  "mobile"
                ]
              },
              {
                "type": "time_window",
