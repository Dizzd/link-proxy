                "start": "08:00",
                "end": "18:00"
              }
            ]
          },
          "action": {
            "type": "redirect",
            "status": 302,
            "target_url": "https://mobile.example.com/",
            "path_handling": "replace",
            "query_policy": "drop"
          },
          "condition_schema_version": 1
        },
        {
          "id": "weekend",
          "name": "Weekend",
          "priority": 10,
          "enabled": true,
          "condition": {
            "type": "time_window",
            "timezone": "Asia/Ho_Chi_Minh",
            "days_of_week": [
              "sat",
              "sun"
            ],
            "start": "00:00",
            "end": "23:59"
          },
          "action": {
            "type": "redirect",
            "status": 302,
            "target_url": "https://weekend.example.com/",
            "path_handling": "replace",
            "query_policy": "drop"
          },
          "condition_schema_version": 1
        }
      ],
      "created_at": "2026-10-29T07:40:51.722834403Z",
